# Nations with missions for the start screen

template north_east_missions {
	starting_nation = {
		tooltip = "presidency_start"
		onmousehierarchyenter = "[SetHighlightCountry( GetCountry('PRI').Self )]"
		blockoverride "flag"
		{
			texture = "[GetCountry('PRI').AccessCoatOfArms.GetTexture('(int32)120','(int32)120')]"
			frame = "[GetCountry('PRI').AccessCoatOfArms.GetFrame('(int32)120','(int32)120')]"
		}
		blockoverride "click"
		{
			onclick = "[SetLobbyCountryTag('PRI')]"
		}
	}
	starting_nation = {
		tooltip = "atlanta_start"
		onmousehierarchyenter = "[SetHighlightCountry( GetCountry('ATL').Self )]"
		blockoverride "flag"
		{
			texture = "[GetCountry('ATL').AccessCoatOfArms.GetTexture('(int32)120','(int32)120')]"
			frame = "[GetCountry('ATL').AccessCoatOfArms.GetFrame('(int32)120','(int32)120')]"
		}
		blockoverride "click"
		{
			onclick = "[SetLobbyCountryTag('ATL')]"
		}
	}
	# Add more missions for the North East here
}

